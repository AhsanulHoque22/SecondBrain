# Copy this file to .env and fill in the values for the backend(s) you use.
# .env is loaded automatically if python-dotenv is installed (it's in
# requirements.txt). Without it, export these as real environment variables
# instead.

# --- Single-backend mode (original, simplest) ----------------------------
# "anthropic" (default), "openai", or "google".
LLM_PROVIDER=anthropic

# Set only the key for the provider you chose above — the others are never
# read. Each SDK also picks these up automatically from the environment;
# they don't need to be passed into code anywhere.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# --- Optional: point the "openai" provider at a compatible endpoint ------
# Groq's free API serves open-weight models (Llama, Qwen, ...) behind an
# OpenAI-compatible endpoint, so LLM_PROVIDER=openai + these two lines run
# this pipeline entirely on Groq's free tier instead of a paid OpenAI key.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-groq-api-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# EXTRACTION_MODEL_CASCADE=llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b,qwen/qwen3-32b,llama-3.3-70b-versatile,openai/gpt-oss-120b

# DeepSeek's API is also OpenAI-compatible — same LLM_PROVIDER=openai path,
# pointed at DeepSeek's endpoint instead. DeepSeek has NO free tier (pay-
# as-you-go only); an unfunded account fails with 402 Insufficient Balance.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-deepseek-api-key-here
# OPENAI_BASE_URL=https://api.deepseek.com
# EXTRACTION_MODEL_CASCADE=deepseek-chat

# --- Extraction model cascade (single-backend mode) -----------------------
# Comma-separated model IDs, cheapest/fastest first. Each tier only runs if
# the previous one's output fails validation, so put your cheapest capable
# model first.
#
# Anthropic has a built-in default cascade and this can be left unset. Every
# other provider requires this to be set explicitly — check that provider's
# own docs for current model IDs; this pipeline does not guess or hardcode
# them for providers it hasn't been run against live.
#
# EXTRACTION_MODEL_CASCADE=claude-haiku-4-5,claude-sonnet-5,claude-opus-4-8


# --- Multi-backend fallback chain (optional, recommended for reliability) -
# Instead of a single provider, try several INDEPENDENTLY configured
# backends in order — if one is unreachable (bad key, zero quota, no
# billing), extraction automatically moves to the next one instead of
# aborting the batch. Each backend keeps its own credentials below, so they
# don't fight over OPENAI_API_KEY/OPENAI_BASE_URL the way single-backend
# mode's Groq/DeepSeek examples above do.
#
# Uncomment to enable (LLM_PROVIDER above is ignored once this is set):
# LLM_BACKEND_CHAIN=groq,google,deepseek,anthropic
#
# GROQ_API_KEY=your-groq-api-key-here           # genuinely free tier, no billing — put first
# GOOGLE_API_KEY=your-google-api-key-here        # free tier IF the key's project has billing/quota enabled
# DEEPSEEK_API_KEY=your-deepseek-api-key-here    # pay-as-you-go only, needs a funded balance
# ANTHROPIC_API_KEY=your-anthropic-api-key-here  # paid, good last resort (most reliable/verified)
#
# Each backend's model cascade defaults to a built-in list of models this
# pipeline has been run against live (see llm_providers.BACKENDS /
# extractor.DEFAULT_BACKEND_CASCADES) — override any one of them with
# {BACKEND}_MODEL_CASCADE:
# GROQ_MODEL_CASCADE=llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b,qwen/qwen3-32b,llama-3.3-70b-versatile,openai/gpt-oss-120b
# GOOGLE_MODEL_CASCADE=gemini-2.0-flash,gemini-2.5-flash,gemini-2.5-pro
# DEEPSEEK_MODEL_CASCADE=deepseek-chat
# ANTHROPIC_MODEL_CASCADE=claude-haiku-4-5,claude-sonnet-5,claude-opus-4-8
#
# A backend with no API key set is skipped automatically — safe to list
# more backends in LLM_BACKEND_CHAIN than you've actually configured keys
# for. If every backend in the chain fails or is unconfigured, extraction
# falls through to the zero-setup heuristic extractor, same as always.
