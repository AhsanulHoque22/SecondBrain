# Copy this file to .env and fill in the values for the provider you use.
# .env is loaded automatically if python-dotenv is installed (it's in
# requirements.txt). Without it, export these as real environment variables
# instead.

# --- Choose one LLM provider -------------------------------------------
# "anthropic" (default), "openai", or "google".
LLM_PROVIDER=anthropic

# --- Provider credentials -----------------------------------------------
# Set only the key for the provider you chose above — the others are never
# read. Each SDK also picks these up automatically from the environment;
# they don't need to be passed into code anywhere.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# --- Optional: point the "openai" provider at a compatible endpoint ------
# Groq's free API serves open-weight models (Llama, Qwen, ...) behind an
# OpenAI-compatible endpoint, so LLM_PROVIDER=openai + these two lines run
# this pipeline entirely on Groq's free tier instead of a paid OpenAI key.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-groq-api-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# EXTRACTION_MODEL_CASCADE=llama-3.1-8b-instant,llama-3.3-70b-versatile

# --- Extraction model cascade --------------------------------------------
# Comma-separated model IDs, cheapest/fastest first. Each tier only runs if
# the previous one's output fails validation, so put your cheapest capable
# model first.
#
# Anthropic has a built-in default cascade and this can be left unset. Every
# other provider requires this to be set explicitly — check that provider's
# own docs for current model IDs; this pipeline does not guess or hardcode
# them for providers it hasn't been run against live.
#
# EXTRACTION_MODEL_CASCADE=claude-haiku-4-5,claude-sonnet-5,claude-opus-4-8
