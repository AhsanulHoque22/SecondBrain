# ──────────────────────────────────────────────────
# Telegram Bot — Required fields
# ──────────────────────────────────────────────────

# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=YOUR_TOKEN_HERE

# Your bot's username (without @)
TELEGRAM_BOT_USERNAME=your_bot_name_bot

# Your Telegram numeric user ID (from @userinfobot → /start)
ALLOWED_USERS=YOUR_USER_ID_HERE

# Directory the bot can read/write (your vault)
APPROVED_DIRECTORY=/home/ahsanul-hoque/Desktop/SecondBrain

# ──────────────────────────────────────────────────
# Optional tuning
# ──────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TURNS=30
VERBOSE_LEVEL=1
SANDBOX_ENABLED=false
